# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- NVIDIA API (chat + embeddings) ----------------------------------------
# https://build.nvidia.com
NVIDIA_API_KEY=
# Optional additional keys for automatic failover on 429s.
NVIDIA_API_KEY_2=
# NVIDIA_API_KEYS=key1,key2,key3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# --- Supabase (analytics + admin users) ------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# --- Groq (voice transcription, optional) ----------------------------------
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=7860
FLASK_DEBUG=0
LOG_LEVEL=INFO
# Set when running behind nginx/Cloudflare so X-Forwarded-For is trusted.
BEHIND_PROXY=0
# Set when served over HTTPS so the session cookie gets the Secure flag.
FORCE_HTTPS=0
# Comma-separated origins allowed to call the API cross-origin. Leave empty
# unless the frontend is hosted on a different domain.
CORS_ORIGINS=
# Return real exception messages to clients. Development only.
EXPOSE_ERRORS=0

# --- Generation ------------------------------------------------------------
MAX_OUTPUT_TOKENS=1400
SINA_MAX_OUTPUT_TOKENS=220
TEMPERATURE=0.35
LLM_TIMEOUT=45

# --- Retrieval -------------------------------------------------------------
CHUNK_TARGET_TOKENS=320
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=8
SINA_TOP_K=4
RETRIEVAL_CANDIDATES=30
CONTEXT_CHAR_BUDGET=9000
SINA_CONTEXT_CHAR_BUDGET=4000
MMR_LAMBDA=0.72
MIN_RELEVANCE=0.18

# --- Caching ---------------------------------------------------------------
RESPONSE_CACHE_SIZE=512
RESPONSE_CACHE_TTL=21600
SEMANTIC_CACHE_THRESHOLD=0.94

# --- Rate limits (requests/seconds, per IP) --------------------------------
RATE_LIMIT_CHAT=20/60
RATE_LIMIT_TTS=30/60
RATE_LIMIT_TRANSCRIBE=20/60
RATE_LIMIT_LOGIN=8/300
RATE_LIMIT_REPORT=10/300
MAX_MESSAGE_CHARS=800
MAX_TTS_CHARS=1200

# Suppress reasoning-model chain-of-thought (Nemotron family). Big latency win.
DISABLE_THINKING=1
